{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build -w @farmscale/web",
  "outputDirectory": "apps/web/.next",
  "crons": [
    {
      "path": "/api/cron/weather-sync",
      "schedule": "0 0 * * *"
    }
  ]
}
