# FarmScale Web App - Environment Variables Example
# Copy this file to .env.local for local development.
# NEVER commit .env or secrets to Git.

# Public API Gateway Base URL (Defaults to sample adapter if omitted)
NEXT_PUBLIC_API_BASE_URL=

# Map Tile Style URL (Optional vector tile JSON endpoint)
NEXT_PUBLIC_MAP_TILE_STYLE_URL=

# Enable AI Assistant Feature Flag (default false)
NEXT_PUBLIC_AI_ENABLED=false
