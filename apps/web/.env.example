# FarmScale Web App - Environment Variables Example
# Copy this file to .env.local for local development.
# NEVER commit .env or secrets to Git.

# Public API Gateway Base URL (Defaults to sample adapter if omitted)
NEXT_PUBLIC_API_BASE_URL=

# Map Tile Style URL (Optional vector tile JSON endpoint)
NEXT_PUBLIC_MAP_TILE_STYLE_URL=

# Enable AI Assistant Feature Flag (default true)
NEXT_PUBLIC_AI_ENABLED=true

# OpenRouter LLM API Key (Optional: for serverless AI advisor on Vercel)
OPENROUTER_API_KEY=

# OpenRouter Model (default: openrouter/free)
OPENROUTER_DEFAULT_MODEL=openrouter/free

# FarmScale Python Gateway URL (Optional: when backend gateway is running)
FARMSCALE_GATEWAY_URL=
