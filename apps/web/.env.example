# FarmScale Web App - Environment Variables Example
# Copy this file to .env.local for local development.
# NEVER commit .env.local or secret keys to Git.

# Public API Gateway Base URL (Defaults to internal Next.js API routes if omitted)
NEXT_PUBLIC_API_BASE_URL=

# Supabase Auth & Database (Optional: for Google Sign-in and farmer profile persistence)
# Set up at https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Weather Sync Cron Security Secret (Vercel Cron / GitHub Actions)
CRON_SECRET=your-random-cron-secret-32-chars

# Agro-Weather Email Dispatcher (Resend API)
RESEND_API_KEY=re_your_api_key_here

# XGBoost ML Serving Service URL (FastAPI)
XGBOOST_SERVICE_URL=http://localhost:8000

# OpenRouter LLM API Key (Optional: for AI advisor assistant)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openrouter/free

# Enable AI Assistant Feature Flag (default true)
NEXT_PUBLIC_AI_ENABLED=true
